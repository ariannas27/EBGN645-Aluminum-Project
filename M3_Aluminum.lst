G e n e r a l   A l g e b r a i c   M o d e l i n g   S y s t e m
C o m p i l a t i o n


   1  *current regions: EU-27, Open-Destinations (OpD), Closed-Destinations(RoW)
   2  set r /EU, OpD, RoW/;
   3  set al /primary, scrap/;
   4   
   5   
   6  *prices USD/metric ton , qty =  metric tons, currently total aluminum (primary + scrap)
   7  parameter
   8   
   9  *!!!!!!!!!!!!!!!!Prices for Importers need to be higher than the respective exporters!!!!!!!!!!!!!!!!
  10  pbar(r,al) /EU.primary 2768, EU.scrap 1745, OpD.primary 2784, OpD.scrap 1707, RoW.primary 2419, RoW.scrap 2000/,
  11  *qty supplied aluminum EU, Open-Destinations, and Closed-Destinations
  12  qbar_s(r,al) /EU.primary 1200000, EU.scrap 5601192, OpD.primary 7898000, OpD.scrap 6113480, RoW.primary 63702000, RoW.scrap 30285328/,
  13  *qty demanded aluminum EU, Open-Destinations, and Closed-Destinations
  14  qbar_d(r,al) /EU.primary 7022482, EU.scrap 5000000, OpD.primary 8623521, OpD.scrap 4374909, RoW.primary 57153997, RoW.scrap 32625091/,
  15   
  16   
  17  *********baseline elasticities*********
  18  *elasticity of supply
  19  e_s(r,al) /EU.primary 0.4, EU.scrap 0.4, OpD.primary 0.4, OpD.scrap 0.4, RoW.primary 0.4, RoW.scrap 0.4/,
  20  *elasticity of demand
  21  e_d(r,al) /EU.primary -0.21, EU.scrap -0.58, OpD.primary -0.21, OpD.scrap -0.58, RoW.primary -0.21, RoW.scrap -0.58/;
  22   
      *************less elastic (scrap) scenario**************
      *elasticity of supply
      e_s(r,al) /EU.primary 0.4, EU.scrap 0.2, OpD.primary 0.4, OpD.scrap 0.2, RoW.primary 0.4, RoW.scrap 0.2/,
      *elasticity of demand 
      e_d(r,al) /EU.primary -0.21, EU.scrap -0.29, OpD.primary -0.21, OpD.scrap -0.29, RoW.primary -0.21, RoW.scrap -0.29/;
       
       
      *************more elastic (scrap) scenario**************
      *elasticity of supply
      e_s(r,al) /EU.primary 0.4, EU.scrap 0.61, OpD.primary 0.4, OpD.scrap 0.61, RoW.primary 0.4, RoW.scrap 0.61/,
      *elasticity of demand 
      e_d(r,al) /EU.primary -0.21, EU.scrap -0.87, OpD.primary -0.21, OpD.scrap -0.87, RoW.primary -0.21, RoW.scrap -0.87/;
  37   
  38   
  39   
  40   
  41   
  42  *currently based off of Pd = a + b*Qd, Ps = c + d*Qs, where a,b,c,d are parameters
  43  parameter a(r,al),b(r,al),c(r,al),d(r,al);
  44   
  45  b(r,al) = pbar(r,al) / (e_d(r,al) * qbar_d(r,al));
  46  a(r,al) = pbar(r,al) - b(r,al) * qbar_d(r,al);
  47  d(r,al) = pbar(r,al) / (e_s(r,al) * qbar_s(r,al));
  48  c(r,al) = pbar(r,al) - d(r,al) * qbar_s(r,al);
  49   
  50  alias(r,rr);
  51  *t will essentially be the cost of transportation
  52  parameter t(r,rr,al);
  53   
  54   
  55  t(r,rr,al) = abs(pbar(rr,al) - pbar(r,al)) ;
  56   
  57  *varibales
  58  positive variable Qd(r,al), Qs(r,al);
  59  **!!!!needs to be for region too!!!!
  60  * variable X(r,al) "exports";
  61  variable W "total welfare";
  62   
  63  *market clearing conditions
  64  equation objfn;
  65   
  66   
  67  alias(r,rr) ;
  68  positive variable ship(r,rr,al) ;
  69   
  70   
  71  objfn.. W =e=
  72     sum((r,al), a(r,al) * Qd(r,al) + b(r,al) * Qd(r,al) *Qd(r,al) /2
  73     - c(r,al) * Qs(r,al) - d(r,al) *Qs(r,al) * Qs(r,al) / 2 )
  74     - sum((r,rr,al), t(r,rr,al) * ship(r,rr,al));
  75   
  76  equation market_clearing_r(r,al) ;
  77  market_clearing_r(r,al)..  Qd(r,al) + sum(rr$(not sameas(r,rr)), ship(r,rr,al)) =e= Qs(r,al) + sum(rr$(not sameas(r,rr)), ship(rr,r,al));
  78   
  79  model simple /all/;
  80   
  81  solve simple using QCP maximizing W;
  82   
  83  *$exit
  84   
  85  parameter rep;
  86  parameter shiprep(*,r,rr,al) "shipments by route";
  87   
  88  ******pre ban results
  89  rep("BAU", "Qd", r, al) = Qd.l(r,al);
  90  rep("BAU", "Qs", r, al) = Qs.l(r,al);
  91  rep("BAU", "P", r, al)  = market_clearing_r.m(r,al);
  92  *total welfare before the ban
  93  rep("BAU", "W", "total", "total") = W.l;
  94  shiprep("BAU", r, rr, al) = ship.l(r,rr,al);
  95   
  96  ****************Scrap ban from eu to closed destinations (row)****************
  97  ship.fx('EU','RoW','scrap') = 0;
  98   
  99  solve simple using QCP maximizing W;
 100   
 101  rep("BAN", "Qd", r, al) = Qd.l(r,al);
 102  rep("BAN", "Qs", r, al) = Qs.l(r,al);
 103  rep("BAN", "P", r, al)  = market_clearing_r.m(r,al);
 104  *total welfare after the ban
 105  rep("BAN", "W", "total", "total") = W.l;
 106  shiprep("BAN", r, rr, al) = ship.l(r,rr,al);
 107   
 108  *one gdx with BAU and BAN
 109  execute_unload "simple.gdx";


